            },
            "proofDisable": {
              "type": "boolean"
            }
          }
        },
        "secureView": {
          "type": "boolean"
        },
        "appRegistry": {
          "type": "string"
        }
      }
    },
    "antivirus": {
      "type": "object",
      "additionalProperties": false,
