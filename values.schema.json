        "existingSecret": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "accessMode": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod",
                "ReadWriteMany",
                "ReadOnlyMany"
              ]
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "accessMode": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod",
                "ReadWriteMany",
                "ReadOnlyMany"
              ]
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$"
            }
          }
        }
      }
