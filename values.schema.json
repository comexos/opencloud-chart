{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "defaultStorageClass": {
          "type": "string"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "externalUrl": {
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "logLevel": {
      "enum": [
        "panic",
        "fatal",
        "error",
        "warn",
        "info",
        "debug",
        "trace"
      ]
    },
    "logPretty": {
      "type": "boolean"
    },
    "insecure": {
      "type": "boolean"
    },
    "additionalServices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludeServices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defaultLanguage": {
      "type": "string"
    },
    "checkForUpdates": {
      "type": "boolean"
    },
    "basicAuth": {
      "type": "boolean"
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "passwordSecretKey": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "demoUsers": {
      "type": "boolean"
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicShareMustHavePassword": {
          "type": "boolean"
        },
        "publicWriteableShareMustHavePassword": {
          "type": "boolean"
        }
      }
    },
    "passwordPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "minCharacters": {
          "type": "integer",
          "minimum": 0
        },
        "minLowercaseCharacters": {
          "type": "integer",
          "minimum": 0
        },
        "minUppercaseCharacters": {
          "type": "integer",
          "minimum": 0
        },
        "minDigits": {
          "type": "integer",
          "minimum": 0
        },
        "minSpecialCharacters": {
          "type": "integer",
          "minimum": 0
        },
        "bannedPasswords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "archiverMaxSize": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "builtin",
            "oidc"
          ]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https?://.+)?$"
            },
            "accountUrl": {
              "type": "string"
            },
            "webClientId": {
              "type": "string"
            },
            "webScopes": {
              "type": "string"
            },
            "audiences": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "userClaim": {
              "type": "string"
            },
            "userCs3Claim": {
              "enum": [
                "username",
                "userid",
                "mail"
              ]
            },
            "autoprovision": {
              "type": "boolean"
            },
            "autoprovisionClaimUsername": {
              "type": "string"
            },
            "roleAssignment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "driver": {
                  "enum": [
                    "oidc",
                    "default"
                  ]
                },
                "claim": {
                  "type": "string"
                },
                "mapping": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role_name",
                      "claim_value"
                    ],
                    "properties": {
                      "role_name": {
                        "enum": [
                          "admin",
                          "spaceadmin",
                          "user",
                          "user-light"
                        ]
                      },
                      "claim_value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "assignDefaultUserRole": {
              "type": "boolean"
            }
          }
        },
        "ldap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string"
            },
            "insecure": {
              "type": "boolean"
            },
            "bindDn": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "bindPasswordSecretKey": {
              "type": "string"
            },
            "bindPassword": {
              "type": "string"
            },
            "userBaseDn": {
              "type": "string"
            },
            "groupBaseDn": {
              "type": "string"
            },
            "userFilter": {
              "type": "string"
            },
            "groupFilter": {
              "type": "string"
            },
            "userSchemaId": {
              "type": "string"
            },
            "groupSchemaId": {
              "type": "string"
            },
            "disableUserMechanism": {
              "enum": [
                "none",
                "attribute",
                "group"
              ]
            },
            "writeEnabled": {
              "type": "boolean"
            },
            "serverUuid": {
              "type": "boolean"
            },
            "refintEnabled": {
              "type": "boolean"
            },
            "groupCreateBaseDn": {
              "type": "string"
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "enum": [
            "posix",
            "decomposed",
            "decomposeds3"
          ]
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "accessKeySecretKey": {
              "type": "string"
            },
            "secretKeySecretKey": {
              "type": "string"
            },
            "accessKey": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        }
      }
