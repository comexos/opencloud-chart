{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "postUpdateOptions": [
    "helmUpdateSubChartArchives"
  ],
  "customManagers": [
    {
      "description": "Container images in values.yaml: registry, repository, tag and digest in that order, kept together.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "registry: \"(?<registry>[^\"]+)\"\\n\\s+repository: \"(?<depName>[^\"]+)\"\\n(?:\\s+#.*\\n)*\\s+tag: \"(?<currentValue>[^\"]+)\"\\n(?:\\s+#.*\\n)*\\s+digest: \"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{{registry}}}/{{{depName}}}",
      "depNameTemplate": "{{{registry}}}/{{{depName}}}"
    },
    {
      "description": "Chart appVersion follows the main image tag; it shares the depName, and so the branch, with the values.yaml pin.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: image=(?<depName>\\S+)\\nappVersion: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Helm version used by the workflows.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+_VERSION: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Tool images run by the scripts and workflows, pinned as image:tag@digest.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/.+\\.sh$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>(?:docker\\.io|ghcr\\.io|quay\\.io)/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "csi-driver-nfs chart version of the shared-storage e2e test.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/e2e/shared/run\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\nCSI_NFS_VERSION=\"\\$\\{CSI_NFS_VERSION:-(?<currentValue>[^}]+)\\}\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Bitnami Common is vendored; the PR carries the rebuilt archive.",
      "matchManagers": [
        "helmv3"
      ],
      "groupName": "Bitnami Common"
    },
    {
      "description": "Pinned GitHub Actions: one weekly PR.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Hash-pinned Python CI tools.",
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "CI Python tools"
    },
    {
      "description": "Web extension images: the tag starts with the app name. Only the version after it is compared, so an app never moves to another app's tag.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|/)opencloudeu/web-extensions$/"
      ],
      "versioning": "regex:^(?<compatibility>[a-z0-9-]+?)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^ci/requirements\\.txt$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^tests/e2e/infra\\.yaml$/",
      "/^tests/e2e/shared/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "enabled": false
  },
  "pip_requirements": {
    "enabled": false
  }
}
